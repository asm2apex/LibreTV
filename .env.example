# 必填：访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：官源解析接口模板。采集站的分集地址是爱奇艺/腾讯/优酷/芒果/B站页面时需要；
# {url} 为页面地址占位符，省略时直接拼在末尾（可原样填厂商给的 &url= 结尾地址）。密钥只留在服务端。
# PARSE_API=https://api.example.com/api/?key=your-key&url={url}
# 可选：官源弹幕接口模板（格式同上），配置后官源解析播放的影片加载对应弹幕
# DANMAKU_API=https://api.example.com/api/?key=your-danmaku-key&dm&url={url}

# 可选：黄果短剧 tab。上游 API 地址（默认官方 Android 端点，一般不用改）
# HUANGGUO_API=https://d2jgz4wrcczusu.cloudfront.net
# 可选：黄果播放分片走向。direct（默认）=浏览器直连 CDN，服务器零视频流量；
# proxy=分片与 key 全部经服务器转发（上游收紧 CORS/防盗链时的回退，双向消耗带宽）
# HUANGGUO_SEG_MODE=direct
# 可选：黄果游客 token 注入（登录被上游按 IP 限频 code=4007 时，从其它出口 IP 取号后填入；正常部署留空自动注册）
# HUANGGUO_TOKEN=
# 可选：黄果 token 落盘路径（默认系统 tmpdir；容器无持久卷时重启会重新注册游客，一般不用改）
# HUANGGUO_TOKEN_FILE=

# 可选：调试
DEBUG=false

# 可选：指定镜像（默认本地构建的 freetv:local）
# FREETV_IMAGE=freetv:local
